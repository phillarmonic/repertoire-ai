# drun (do-run) CLI is a fast, semantic task runner with
# its own powerful automation language. Effortless tasks, serious speed.
# Learn more at https://github.com/phillarmonic/drun

version: 2.0

project "repertoire-ai" version "1.9.0":
	requires tools:
		go >= "1.27"
		golangci-lint provision
		gosec provision
		govulncheck
        gofumpt provision
    scm: # Declare a specific SCM implementation for easier manipulation
        git: # Technology
            github: # Provider
                repertoire: # Repo alias (can be potato if you want to, just for convenience when referencing in git commands)
                    default: https
                    https: "https://github.com/phillarmonic/repertoire-ai.git"
                    ssh: "git@github.com:phillarmonic/repertoire-ai.git"
                    cli:
                        repository: "phillarmonic/repertoire-ai"
                        host: "github.com"

task "vet" means "Run Go static analysis":
	run "go vet -tags sqlite_fts5 ./..."

task "lint" means "Check Go source formatting":
	run "golangci-lint run --build-tags sqlite_fts5 ./..."

task "test" means "Run the Go test suite":
	run "go test -tags sqlite_fts5 ./..."

task "vuln" means "Check dependencies for known vulnerabilities":
	run "govulncheck ./..."

task "build" means "Build every Go package":
	run "go build -tags sqlite_fts5 ./..."

task "install" means "Install repertoire with local build information":
	run "go install -ldflags=\"-X 'main.version=dev-$(git rev-parse --short HEAD) (built at $(date -u '+%Y-%m-%d %H:%M:%S UTC'))'\" ./cmd/repertoire"
	success "repertoire installed"

task "installer" means "Build fresh Windows binaries and package the per-user NSIS installer":
	requires tools:
		go
		makensis
	given $version defaults to "dev"
	info "Building amd64 + arm64 Windows binaries ({$version}) into dist and packaging dist/repertoire-setup-{$version}.exe"
	run "mkdir -p dist"
	run "CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -ldflags=\"-s -w -buildid= -X 'main.version={$version}'\" -o dist/repertoire-windows-amd64.exe ./cmd/repertoire"
	run "CGO_ENABLED=0 GOOS=windows GOARCH=arm64 go build -trimpath -ldflags=\"-s -w -buildid= -X 'main.version={$version}'\" -o dist/repertoire-windows-arm64.exe ./cmd/repertoire"
	run "makensis \"-DVERSION={$version}\" installer/repertoire.nsi"
	success "Windows installer built into dist/repertoire-setup-{$version}.exe"

task "sec" means "Security checks (high)":
	run "gosec -tags sqlite_fts5 -severity high -confidence medium ./..."

task "docs" means "Runs the Zensical documentation":
    requires tools:
        uv
    run "uv run zensical serve"

task "ci" mode "ci" means "Run all required project checks":
	call task "vuln"
	call task "vet"
	call task "lint"
	call task "test"
	call task "build"
	call task "sec"

task "changelog" means "Generates the changelog for the project":
    given $version as string matching semver_optional_v
    step "Generating changelog for version {$version}"
    promote changelog "CHANGELOG.md" to version "{$version}"
    success "Changelog generated for version {$version}"

task "prepare-release" means "Runs checks related to going to a next release":
    requires $version as string matching semver_optional_v
    # Interactive gate (dogfooding confirm): declining aborts the release
    # prep gracefully. Defaults to yes so unattended runs keep going.
    confirm "Prepare release v{$version}?" defaults to "yes"
    step "Preflight. Proposed version: v{$version}"
    # Magic method for comparison (you can do this manually if you want to)
    git ensure $version is newer than latest version from repertoire
    step "Preflight checks have passed. Will now run the CI."
    call task ci
    step "Promoting unreleased changelog entries to {$version}"
    promote changelog "CHANGELOG.md" to version "{$version}"
    update project version to "{$version}"
    success "According to the current spec, you should be good to go."
    warning "But be mindful, with great power, comes great responsibility."